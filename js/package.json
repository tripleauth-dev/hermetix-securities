{
  "name": "hermetix",
  "version": "0.11.0",
  "description": "증권사 모의투자 통합 트레이딩 프레임워크 - JavaScript/TypeScript",
  "keywords": [
    "trading",
    "paper-trading",
    "stock",
    "bot",
    "korea",
    "broker",
    "kis",
    "kiwoom",
    "websocket"
  ],
  "homepage": "https://github.com/tripleauth-dev/hermetix-securities/tree/main/js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tripleauth-dev/hermetix-securities.git",
    "directory": "js"
  },
  "bugs": {
    "url": "https://github.com/tripleauth-dev/hermetix-securities/issues"
  },
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "tsc",
    "test": "npm run build && node --test \"dist/tests/*.test.js\"",
    "smoke": "npm run build && node dist/tests/smoke.js"
  },
  "dependencies": {
    "decimal.js": "^10.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/ws": "^8.18.1",
    "typescript": "^5.5.0",
    "ws": "^8.21.3"
  },
  "license": "MIT"
}
